<div class="container mx-auto px-4 py-6">
  <h1 class="mb-8">Settings</h1>

  <div class="max-w-2xl mx-auto space-y-8">
    <!-- Change Email Section -->
    <div class="section p-6">
      <h2 class="mb-4">Change Email</h2>

      <.form let={f} for={@email_changeset} action={Routes.user_settings_path(@conn, :update)} id="update_email" class="formstyle">
        <%= if @email_changeset.action do %>
          <div class="bg-red-900 border border-red-700 rounded p-3 mb-4">
            <p class="text-red-200">Oops, something went wrong! Please check the errors below.</p>
          </div>
        <% end %>

        <%= hidden_input f, :action, name: "action", value: "update_email" %>

        <div class="mb-4">
          <%= label f, :email, class: "block mb-2" %>
          <%= email_input f, :email, required: true, class: "text w-full" %>
          <%= error_tag f, :email %>
        </div>

        <div class="mb-4">
          <%= label f, :current_password, "Current password", for: "current_password_for_email", class: "block mb-2" %>
          <%= password_input f, :current_password, required: true, name: "current_password", id: "current_password_for_email", class: "text w-full" %>
          <%= error_tag f, :current_password %>
        </div>

        <div class="pt-2">
          <%= submit "Change email", class: "submit" %>
        </div>
      </.form>
    </div>

    <!-- Change Nickname Section -->
    <div class="section p-6">
      <h2 class="mb-4">Change Nickname</h2>

      <.form let={f} for={@nick_changeset} action={Routes.user_settings_path(@conn, :update)} id="update_nick" class="formstyle">
        <%= if @nick_changeset.action do %>
          <div class="bg-red-900 border border-red-700 rounded p-3 mb-4">
            <p class="text-red-200">Oops, something went wrong! Please check the errors below.</p>
          </div>
        <% end %>

        <%= hidden_input f, :action, name: "action", value: "update_nick" %>

        <div class="mb-4">
          <%= label f, :nickname, class: "block mb-2" %>
          <%= text_input f, :nickname, required: true, class: "text w-full" %>
          <%= error_tag f, :nickname %>
        </div>

        <div class="pt-2">
          <%= submit "Change Nickname", class: "submit" %>
        </div>
      </.form>
    </div>

    <!-- Theme Selection -->
    <div class="section p-6">
      <h2 class="mb-4">Theme Preference</h2>

      <.form let={f} for={@theme_changeset} action={Routes.user_settings_path(@conn, :update)} id="update_theme" class="formstyle">
        <%= hidden_input f, :action, name: "action", value: "update_theme" %>

        <div class="mb-4">
          <div class="flex gap-4">
            <label class="flex items-center cursor-pointer">
              <%= radio_button f, :theme, "dark", class: "mr-2" %>
              <span>🌙 Dark Mode</span>
            </label>

            <label class="flex items-center cursor-pointer">
              <%= radio_button f, :theme, "light", class: "mr-2" %>
              <span>☀️ Light Mode</span>
            </label>
          </div>
        </div>

        <div class="pt-2">
          <%= submit "Save Theme", class: "submit" %>
        </div>
      </.form>
    </div>

    <!-- Unread Scroll Behavior -->
    <div class="section p-6">
      <h2 class="mb-2">Unread Post Behavior</h2>
      <p class="text-sm text-gray-400 mb-4">
        When enabled, opening a scene scrolls to where you left off and tracks
        which posts you've actually read. Disable this if you prefer to always
        land at the latest posts and skip the backlog.
      </p>

      <.form let={f} for={@smart_unread_changeset} action={Routes.user_settings_path(@conn, :update)} id="update_smart_unread" class="formstyle">
        <%= hidden_input f, :action, name: "action", value: "update_smart_unread" %>

        <label class="flex items-center gap-3 cursor-pointer">
          <%= checkbox f, :smart_unread, class: "mr-2" %>
          <span>Track read position and scroll to last-read post</span>
        </label>

        <div class="pt-3">
          <%= submit "Save", class: "submit" %>
        </div>
      </.form>
    </div>

    <!-- Activity notifications -->
    <div class="section p-6">
      <h2 class="mb-2">Activity notifications</h2>
      <p class="text-sm text-gray-400 mb-4">
        Optional louder cues — a sound, or an OS desktop notification — layered on top of the
        quiet unread badges the site already shows. Everything here is off unless you turn it on,
        and cues only ever fire while you have a tab open. You are never alerted about your own
        activity or about the page you are already looking at.
      </p>

      <.form let={f} for={@notification_prefs_changeset} action={Routes.user_settings_path(@conn, :update)} id="update_notification_prefs" class="formstyle">
        <%= hidden_input f, :action, name: "action", value: "update_notification_prefs" %>

        <table class="text-sm" id="notif-prefs-grid">
          <thead>
            <tr>
              <th class="text-left pr-6 pb-2">Source</th>
              <th class="pr-6 pb-2">Sound</th>
              <th class="pb-2">Desktop notification</th>
            </tr>
          </thead>
          <tbody>
            <%= for {field_key, label} <- [
                  {"scene", "Scene posts"},
                  {"library", "Library edits & marginalia"},
                  {"bbs", "Linkpearl threads & replies"},
                  {"rumor", "Rumor map nodes"}
                ] do %>
              <tr>
                <td class="text-left pr-6 py-1"><%= label %></td>
                <td class="text-center pr-6 py-1">
                  <%= checkbox f, String.to_atom("notif_#{field_key}_sound"), class: "notif-sound-box" %>
                </td>
                <td class="text-center py-1">
                  <%= checkbox f, String.to_atom("notif_#{field_key}_web"), class: "notif-web-box" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>

        <p id="notif-perm-note" class="text-xs text-amber-400 mt-2" hidden>
          Desktop notifications are blocked in your browser settings for this site. Re-enable them
          in your browser to use the desktop-notification cues. The sound cues still work.
        </p>

        <div class="pt-3">
          <%= submit "Save", class: "submit" %>
        </div>
      </.form>
    </div>

    <!-- Dragon-only: Site Settings -->
    <%= if @conn.assigns[:role] == :dragon do %>
      <div class="section p-6 border-2 border-purple-700">
        <h2 class="mb-2">Site Settings <span class="text-sm font-normal text-purple-400">(Dragon only)</span></h2>

        <form action={Routes.user_settings_path(@conn, :update)} method="post" class="formstyle">
          <%= hidden_input :site_settings, :action, name: "action", value: "update_site_settings" %>
          <input type="hidden" name="_method" value="put" />
          <%= csrf_input_tag(Routes.user_settings_path(@conn, :update)) %>

          <label class="flex items-center gap-3 cursor-pointer mb-4">
            <input type="hidden" name="site_settings[bbs_enabled]" value="false" />
            <input
              type="checkbox"
              name="site_settings[bbs_enabled]"
              value="true"
              class="mr-2"
              checked={@site_settings.bbs_enabled}
            />
            <span>Show Linkpearl in navigation for all users</span>
          </label>

          <label class="flex items-center gap-3 cursor-pointer mb-4">
            <input type="hidden" name="site_settings[library_enabled]" value="false" />
            <input
              type="checkbox"
              name="site_settings[library_enabled]"
              value="true"
              class="mr-2"
              checked={@site_settings.library_enabled}
            />
            <span>Show Liminal Library in navigation for all users</span>
          </label>

          <div class="pt-2">
            <button type="submit" class="submit">Save Site Settings</button>
          </div>
        </form>

        <div class="mt-4 pt-4 border-t border-purple-800">
          <a href="/library/admin" class="text-purple-400 hover:text-purple-200 text-sm">→ Library Admin (typeface assignments)</a>
        </div>
      </div>
    <% end %>

    <!-- Change Password Section -->
    <div class="section p-6">
      <h2 class="mb-4">Change Password</h2>

      <.form let={f} for={@password_changeset} action={Routes.user_settings_path(@conn, :update)} id="update_password" class="formstyle">
        <%= if @password_changeset.action do %>
          <div class="bg-red-900 border border-red-700 rounded p-3 mb-4">
            <p class="text-red-200">Oops, something went wrong! Please check the errors below.</p>
          </div>
        <% end %>

        <%= hidden_input f, :action, name: "action", value: "update_password" %>

        <div class="mb-4">
          <%= label f, :password, "New password", class: "block mb-2" %>
          <%= password_input f, :password, required: true, class: "text w-full" %>
          <%= error_tag f, :password %>
        </div>

        <div class="mb-4">
          <%= label f, :password_confirmation, "Confirm new password", class: "block mb-2" %>
          <%= password_input f, :password_confirmation, required: true, class: "text w-full" %>
          <%= error_tag f, :password_confirmation %>
        </div>

        <div class="mb-4">
          <%= label f, :current_password, "Current password", for: "current_password_for_password", class: "block mb-2" %>
          <%= password_input f, :current_password, required: true, name: "current_password", id: "current_password_for_password", class: "text w-full" %>
          <%= error_tag f, :current_password %>
        </div>

        <div class="pt-2">
          <%= submit "Change password", class: "submit" %>
        </div>
      </.form>
    </div>
  </div>
</div>

<script>
  (function () {
    var form = document.getElementById("update_notification_prefs");
    if (!form) return;

    var note = document.getElementById("notif-perm-note");
    var webBoxes = form.querySelectorAll(".notif-web-box");

    function notifySupported() {
      return typeof window.Notification !== "undefined";
    }

    function disableWebBox(box) {
      box.disabled = true;
      var hiddenInput = form.querySelector('input[type=hidden][name="' + box.name + '"]');
      if (hiddenInput) hiddenInput.disabled = true;
    }

    function disableAllWebBoxes() {
      webBoxes.forEach(function (b) { disableWebBox(b); });
    }

    // AC5.6: permission already denied at page load -> disable web boxes, show note.
    if (!notifySupported() || Notification.permission === "denied") {
      disableAllWebBoxes();
      if (note) note.hidden = false;
    }

    // AC5.4 / AC5.5: first time a web box is enabled, request permission; revert on denial.
    webBoxes.forEach(function (box) {
      box.addEventListener("change", function () {
        if (!box.checked) return;
        if (!notifySupported()) {
          box.checked = false;
          if (note) note.hidden = false;
          return;
        }
        if (Notification.permission === "granted") return;

        function handlePermissionResult(result) {
          if (result !== "granted") {
            box.checked = false;
            if (result === "denied") {
              disableAllWebBoxes();
              if (note) note.hidden = false;
            }
          }
        }

        var p = Notification.requestPermission(handlePermissionResult);
        if (p && p.then) p.then(handlePermissionResult);
      });
    });
  })();
</script>